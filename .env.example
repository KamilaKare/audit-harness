AUDIT_DATA_DIR=data
AUDIT_CONTROLS_DIR=controls
AUDIT_DATABASE_URL=sqlite:///./audit.db
AUDIT_PROVIDER=offline
AUDIT_MODEL=gpt-4.1-mini
AUDIT_LLM_TIMEOUT_SECONDS=20
# Required to access API except /health. Set a long random value.
AUDIT_API_KEY=replace-with-a-long-random-secret
# Required only for the openai-compatible provider.
AUDIT_LLM_API_KEY=
AUDIT_LLM_BASE_URL=https://api.openai.com/v1
AUDIT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional trace segmentation. Keys are loaded directly from .env by the SDK adapter.
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=audit-harness@0.1.0
LANGFUSE_SAMPLE_RATE=1.0
# Dashboard talks to the API; it does not read or write the database directly.
AUDIT_DASHBOARD_API_URL=http://127.0.0.1:8000
AUDIT_DASHBOARD_TIMEOUT_SECONDS=180
AUDIT_PRICING_FILE=config/model_pricing.yaml
